---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { blogPosts, formatPostDate, getPostPath } from '../../data/blog';
---

<BaseLayout title="Blog" description="Payroll articles and updates from Integrated Payroll.">
	<PageHero title="Blog" />
	<section class="section">
		<div class="container blog-list">
			{blogPosts.map((post) => (
				<article class="blog-card">
					<img src={post.image} alt="" width="500" height="500" />
					<div>
						<h2><a href={getPostPath(post)}>{post.title}</a></h2>
						<p>Posted on <a href={getPostPath(post)}>{formatPostDate(post.date)}</a> in {post.categories.join(', ')}</p>
						<p>{post.excerpt}</p>
						<a href={getPostPath(post)}>Read More</a>
					</div>
				</article>
			))}
		</div>
	</section>
</BaseLayout>