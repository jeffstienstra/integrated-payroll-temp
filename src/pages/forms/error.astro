---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonLink from '../../components/ButtonLink.astro';
---

<BaseLayout title="Something Went Wrong" description="An unexpected error occurred.">
	<section class="section">
		<div class="container centered">
			<h1>Something Went Wrong</h1>
			<p>We ran into an unexpected issue while loading this page.</p>
			<p>Please try again, or use one of the links below to continue.</p>
			<div class="button-row">
				<ButtonLink href="/" text="Return Home" />
				<ButtonLink href="/payroll-resources/" text="Forms & Links" />
				<ButtonLink href="/contact-us/" text="Contact Us" />
			</div>
		</div>
	</section>
</BaseLayout>
