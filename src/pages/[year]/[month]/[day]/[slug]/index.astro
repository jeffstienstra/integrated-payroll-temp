---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../../components/PageHero.astro';
import { blogPosts, formatPostDate } from '../../../../../data/blog';

export function getStaticPaths() {
	return blogPosts.map((post) => {
		const [year, month, day] = post.date.split('-');
		return {
			params: { year, month, day, slug: post.slug },
			props: { post },
		};
	});
}

const { post } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt} ogImage={post.image}>
	<PageHero title={post.title} subtitle={`Posted on ${formatPostDate(post.date)}`} />
	<section class="section">
		<article class="container post-content">
			<img src={post.image} alt="" width="848" height="479" />
			<Fragment set:html={post.content} />
		</article>
	</section>
</BaseLayout>